# Renderer service
PORT=3100
RENDER_BACKEND=local
RENDER_OUTPUT_DIR=./render_artifacts
RENDERER_SHARED_SECRET=change-me-renderer-secret
RENDER_MAX_DURATION_SEC=180
RENDER_MAX_FPS=60
RENDER_MAX_SNAPSHOT_BYTES=512000
RENDER_MAX_ACTIVE_RENDERS=8
RENDER_SUBMIT_WINDOW_MS=60000
RENDER_SUBMIT_MAX_PER_WINDOW=20
RENDER_MAX_TRACKED_STATES=2000
RENDER_STATE_RETENTION_MS=600000
RENDER_MAX_RATE_WINDOW_KEYS=10000
RENDER_RATE_WINDOW_RETENTION_MS=120000

# Optional local Chrome override
# REMOTION_CHROME_EXECUTABLE=/path/to/chrome
RENDERER_MAPBOX_TOKEN=
RENDERER_MAP_STYLE=mapbox/navigation-night-v1

# Lambda mode (6C)
AWS_REGION=us-east-1
LAMBDA_FUNCTION_NAME=
LAMBDA_SERVE_URL=
LAMBDA_OUTPUT_BUCKET=
LAMBDA_MEMORY_MB=2048
LAMBDA_TIMEOUT_SECONDS=900
LAMBDA_DISK_MB=2048
LAMBDA_ARCHITECTURE=arm64
LAMBDA_SITE_NAME=dora-classic
LAMBDA_FRAMES_PER_LAMBDA=200
LAMBDA_MAX_TRACKED_RENDERS=2000
LAMBDA_RENDER_RETENTION_MS=600000
