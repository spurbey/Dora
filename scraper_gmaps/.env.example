# Copy this to .env and fill in your values

# Proxy settings (residential recommended for Google Maps)
PROXY_URL=http://user:pass@proxy-host:port
# Comma-separated list for rotation
PROXY_POOL=http://user:pass@host1:port,http://user:pass@host2:port

# CAPTCHA solver (optional but recommended)
CAPSOLVER_API_KEY=your_capsolver_key_here
TWOCAPTCHA_API_KEY=your_2captcha_key_here

# Storage
DB_PATH=data/reviews.db

# Pacing (seconds)
SCROLL_DELAY_MIN=1.5
SCROLL_DELAY_MAX=3.5
REQUEST_DELAY_MIN=2.0
REQUEST_DELAY_MAX=5.0

# Limits
MAX_REVIEWS_PER_PLACE=500
MAX_RETRIES=3
SESSION_ROTATE_AFTER=50   # rotate session every N places

# Monitoring
ALERT_DIVERGENCE_THRESHOLD=0.05   # alert if extracted < 95% of captured
SNAPSHOT_ENABLED=true

# Locale (match your proxy exit node)
LOCALE=en-US
TIMEZONE=America/New_York